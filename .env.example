# ---------------------------------------------------------------------------
# BeauFinance environment. Copy to .env.local and fill in. NEVER commit secrets.
# ---------------------------------------------------------------------------

# --- Mode A: Production on Supabase + Vercel (recommended) -----------------
# Auth provider: "supabase" or "local"
AUTH_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Public URL of the deployed app (used for email-confirmation redirects)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Server-only Postgres connection string (Supabase > Project Settings > Database >
# Connection string > Transaction pooler, port 6543). Used ONLY on the server.
# Every query runs as the `authenticated` role with the user's JWT claims, so RLS applies.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# --- Mode B: Local development (no external services) ----------------------
# AUTH_PROVIDER=local
# Leave DATABASE_URL empty to use an embedded PostgreSQL (PGlite) stored in ./.data
# DATABASE_URL=
# PGLITE_DATA_DIR=./.data/pglite
# Secret used to sign local session cookies (32+ random chars). Required for AUTH_PROVIDER=local.
# AUTH_SECRET=change-me-to-a-long-random-string

# Optional: max server-side connections when using DATABASE_URL (default 5)
# DATABASE_POOL_MAX=5

# Required in production when store integrations are enabled (32 bytes, base64 or 64 hex chars):
# INTEGRATIONS_ENCRYPTION_KEY=
# Shared secret for the scheduled sync endpoint (Vercel sends it as a Bearer token):
# CRON_SECRET=
